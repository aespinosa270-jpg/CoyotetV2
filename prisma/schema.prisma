generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================================
// ENUMS GLOBALES
// ==========================================================

enum EmployeeRole {
  ADMIN
  SUPERVISOR
  VENDEDORA
  LOGISTICA
  CONTABILIDAD
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  FAILED
}

enum LogisticsType {
  COYOTE_LOCAL
  SKYDROPX_NACIONAL
}

enum PickupLocation {
  GUATEMALA_97
  PLOMO_203
}

enum PipelineStatus {
  PROSPECTO
  COTIZANDO
  NEGOCIACION
  CERRADO_GANADO
  CERRADO_PERDIDO
}

enum InteractionType {
  LLAMADA
  WHATSAPP
  CORREO
  PRESENCIAL
}

enum TicketStatus {
  ABIERTO
  EN_REVISION
  RESUELTO
  CERRADO
}

enum TicketPriority {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum MembershipTier {
  NONE
  GOLD
  BLACK
  ELITE
}

enum VehicleStatus {
  ACTIVE
  IN_REPAIR
  RETIRED
}

enum VehicleLogType {
  GASOLINA
  SERVICIO
  REPARACION
}

enum RouteOrderType {
  RECOLECCION
  RESTOCK_INTERNO
  RESTOCK_PROVEEDOR
  ENTREGA_PAQUETERIA
  ENTREGA_DOMICILIO
}

enum RouteOrderStatus {
  PENDIENTE
  ASIGNADA
  EN_CAMINO
  COMPLETADA
  CANCELADA
}

enum UnitType {
  KILO
  METRO
  PIEZA
}

enum MovementType {
  ENTRADA
  SALIDA
  AJUSTE
}

enum CommissionStatus {
  PENDIENTE
  APROBADA
  PAGADA
  RECHAZADA
}

enum WaMessageRole {
  AGENT
  CLIENT
}

enum BreakType {
  BANO
  LUNCH
  PEDIDO
  ENTRENAMIENTO
}

enum ChatHandler {
  BOT
  AGENT
  ADMIN
}

enum TelaSolicitadaStatus {
  NUEVA
  EN_EVALUACION
  APROBADA
  RECHAZADA
  AGREGADA_AL_CATALOGO
}

// ==========================================================
// 1. USUARIO / CLIENTE (B2B & B2C)
// ==========================================================
model User {
  id                           String         @id @default(cuid())
  hashId                       String         @unique @default(dbgenerated("concat('CL-', substr(gen_random_uuid()::text, 1, 6))"))
  name                         String?
  email                        String         @unique
  password                     String
  image                        String?
  phone                        String?
  role                         String         @default("USER")
  membershipTier               MembershipTier @default(NONE)
  membershipExpiry             DateTime?
  membershipColocacionesUsadas Int            @default(0)
  points                       Int            @default(0)
  stripeCustomerId             String?
  stripeSubscriptionId         String?
  stripeSubscriptionStatus     String?
  ltv                          Float          @default(0)
  rfc                          String?
  taxRegime                    String?
  cfdiUse                      String?
  street                       String?
  neighborhood                 String?
  zipCode                      String?
  city                         String?
  state                        String?
  company                      String?
  notes                        String?
  optedIn                      Boolean        @default(false)
  suppressed                   Boolean        @default(false)
  consentDate                  DateTime?
  optOutDate                   DateTime?
  createdAt                    DateTime       @default(now())
  updatedAt                    DateTime       @updatedAt

  orders             Order[]
  interactions       Interaction[]
  tickets            Ticket[]
  deals              Deal[]
  waConversations    WaConversation[]
  passwordResetToken PasswordResetToken?
  ticketMessages     TicketMessage[]

  // Índices de rendimiento
  @@index([email])
  @@index([phone])
}

// ==========================================================
// 1b. RECUPERACIÓN DE CONTRASEÑA
// ==========================================================
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

// ==========================================================
// 2. LA JAURIA (EQUIPO INTERNO)
// ==========================================================
model Employee {
  id       String       @id @default(cuid())
  name     String
  email    String       @unique
  password String
  role     EmployeeRole @default(VENDEDORA)
  isActive Boolean      @default(true)

  isBlocked          Boolean  @default(false)
  suspendedFunctions String[]

  commissionRate Float     @default(0.03)
  status         String    @default("offline")
  lastActiveAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  logs            AuditLog[]
  attendances     Attendance[]
  interactions    Interaction[]
  assignedTickets Ticket[]
  ticketMessages  TicketMessage[]
  telemetry       Telemetry[]
  routeOrders     RouteOrder[]
  deals           Deal[]
  commissions     Commission[]
  waConversations WaConversation[]

  // Sales Agent (Fase 1 — reactivacion contactos frios)
  assignedColdContacts ContactoOutbound[]   @relation("AssignedColdContacts")
  salesAgentAttempts   SalesAgentAttempt[]  @relation("SalesAgentSentBy")
  salesAgentFeedbacks  SalesAgentFeedback[] @relation("SalesAgentFeedbacks")
}

model AuditLog {
  id         String    @id @default(cuid())
  timestamp  DateTime  @default(now())
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  action     String
  resourceId String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?

  // Índices de rendimiento para auditorías rápidas
  @@index([employeeId])
  @@index([timestamp(sort: Desc)])
}

// ==========================================================
// 3. CATALOGO CENTRAL & INVENTARIO FISICO
// ==========================================================
model Product {
  id                  String   @id @default(cuid())
  sku                 String   @unique
  title               String
  unit                UnitType @default(KILO)
  thumbnail           String?
  description         String?
  composicion         String?
  gramaje             String?
  ancho               String?
  rendimiento         Float?
  priceMenudeo        Float
  priceMayoreo        Float
  hasRollo            Boolean  @default(true)
  unidadesPorRollo    Float?
  singleColor         Boolean  @default(true)
  origin              String?
  category            String
  // Sourcing operativo
  cantidadInmediataKg Float?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  colors     ProductColor[]
  inventory  Inventory[]
  orderItems OrderItem[]
  deals      Deal[]
  movements  InventoryMovement[]

  // Índices de rendimiento
  @@index([category])
  @@index([isActive])
}

model ProductColor {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  hex       String
  imageUrl  String?

  inventory Inventory[]
  movements InventoryMovement[]

  @@index([productId])
}

model Inventory {
  id        String         @id @default(cuid())
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorId   String?
  color     ProductColor?  @relation(fields: [colorId], references: [id])
  location  PickupLocation
  quantity  Float
  rollCount Int            @default(0)
  updatedAt DateTime       @updatedAt

  @@unique([productId, colorId, location])
  @@index([location])
}

model InventoryMovement {
  id           String         @id @default(cuid())
  productId    String
  product      Product        @relation(fields: [productId], references: [id])
  colorId      String?
  color        ProductColor?  @relation(fields: [colorId], references: [id])
  location     PickupLocation
  type         MovementType
  quantity     Float
  rollCount    Int            @default(0)
  provider     String?
  authorizedBy String
  notes        String?
  orderId      String?
  order        Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())

  @@index([productId])
  @@index([createdAt(sort: Desc)])
}

// ==========================================================
// 4. CRM: PIPELINE & VENTAS MAYORISTAS
// ==========================================================
model Deal {
  id         String         @id @default(cuid())
  title      String
  company    String
  userId     String?
  user       User?          @relation(fields: [userId], references: [id])
  employeeId String
  employee   Employee       @relation(fields: [employeeId], references: [id])
  productId  String?
  product    Product?       @relation(fields: [productId], references: [id])
  color      String?
  quantity   Float?
  value      Float          @default(0)
  status     PipelineStatus @default(PROSPECTO)
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  commission Commission?

  @@index([employeeId])
  @@index([status])
}

// ==========================================================
// 4b. COMISIONES
// ==========================================================
model Commission {
  id         String           @id @default(cuid())
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id])
  dealId     String           @unique
  deal       Deal             @relation(fields: [dealId], references: [id])
  amount     Float
  rate       Float
  status     CommissionStatus @default(PENDIENTE)
  approvedBy String?
  approvedAt DateTime?
  paidAt     DateTime?
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([employeeId])
  @@index([status])
}

// ==========================================================
// 5. E-COMMERCE & LOGISTICA DE COMPRA
// ==========================================================
model Order {
  id             String         @id @default(cuid())
  orderNumber    String         @unique @default(cuid())
  userId         String?
  user           User?          @relation(fields: [userId], references: [id])
  subtotal       Float          @default(0)
  freightCost    Float          @default(0)
  shippingCost   Float          @default(0)
  serviceFee     Float          @default(0)
  taxIVA         Float          @default(0)
  total          Float
  status         OrderStatus    @default(PENDING)
  evidenceUrl    String?
  deliveryLat    Float?
  deliveryLng    Float?
  paymentMethod  String         @default("card")
  paymentId      String?
  logisticsType  LogisticsType  @default(SKYDROPX_NACIONAL)
  pickupLocation PickupLocation @default(GUATEMALA_97)

  pickupIdPhotoUrl  String?
  pickupPlateNumber String?
  pickupConfirmedBy String?
  pickupConfirmedAt DateTime?

  vehiclesNeeded Int     @default(1)
  trackingNumber String?
  trackingUrl    String?
  customerName   String
  customerEmail  String
  customerPhone  String?
  address        String?
  wantsInvoice   Boolean @default(false)
  invoiceStatus  String?

  // ── Bot v2 metadata (Fase 12) ──
  source            String? // "bot_v2" | "crm" | "web" | null
  botPhone          String? // teléfono E.164 del cliente en el bot
  botConversationId String? // ID interno de la conversación

  // ── Despacho (Fase 12) ──
  preparedAt  DateTime?
  preparedBy  String?
  shippedAt   DateTime?
  shippedBy   String?
  deliveredAt DateTime?

  // Sourcing operativo (interno, oculto al cliente)
  requiresSourcing      Boolean   @default(false)
  sourcingStatus        String?
  sourcingDays          Int?
  sourcingPromisedAt    DateTime?
  sourcingResolvedAt    DateTime?
  sourcingInternalNotes String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  items     OrderItem[]
  tickets   Ticket[]
  movements InventoryMovement[]
  vehicleId String?
  vehicle   Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  // Índices de rendimiento
  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  title     String
  sku       String?
  price     Float
  quantity  Float
  unit      String?
  color     String?

  @@index([orderId])
}

// ==========================================================
// 6. ERP & OPERACION INTERNA
// ==========================================================
model Attendance {
  id              String    @id @default(cuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id])
  checkIn         DateTime  @default(now())
  checkOut        DateTime?
  horasTrabajadas Float?
  ipAddress       String?
  location        String?
  lat             Float?
  lng             Float?
  checkOutLat     Float?
  checkOutLng     Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  breaks AttendanceBreak[]

  @@index([employeeId])
  @@index([createdAt(sort: Desc)])
}

model AttendanceBreak {
  id           String     @id @default(cuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  type         BreakType
  startAt      DateTime   @default(now())
  endAt        DateTime?
  duration     Float?
  createdAt    DateTime   @default(now())

  @@index([attendanceId])
}

model Interaction {
  id             String          @id @default(cuid())
  employeeId     String?
  employee       Employee?       @relation(fields: [employeeId], references: [id])
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  type           InteractionType
  summary        String
  content        Json?
  status         String          @default("open")
  pipelineStatus PipelineStatus?
  date           DateTime        @default(now())
  nextFollowUp   DateTime?

  @@index([userId])
  @@index([employeeId])
}

model ShippingZone {
  id            String   @id @default(cuid())
  name          String
  zipCodes      String[]
  baseRate      Float    @default(0)
  estimatedDays Int      @default(1)
  isActive      Boolean  @default(true)
}

model Ticket {
  id           String         @id @default(cuid())
  ticketNumber String         @unique @default(dbgenerated("concat('TK-', substr(gen_random_uuid()::text, 1, 6))"))
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  employeeId   String?
  employee     Employee?      @relation(fields: [employeeId], references: [id])
  orderId      String?
  order        Order?         @relation(fields: [orderId], references: [id])
  subject      String
  description  String
  status       TicketStatus   @default(ABIERTO)
  priority     TicketPriority @default(MEDIA)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  messages TicketMessage[]

  @@index([userId])
  @@index([status])
}

model TicketMessage {
  id         String    @id @default(cuid())
  ticketId   String
  ticket     Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  body       String
  isInternal Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([ticketId])
  @@index([createdAt(sort: Asc)])
}

// ==========================================================
// 7. FLOTILLA AVANZADA Y RUTAS
// ==========================================================
model Vehicle {
  id              String        @id @default(cuid())
  plate           String        @unique
  model           String
  lastMaintenance DateTime      @default(now())
  nextMaintenance DateTime
  mileage         Float         @default(0)
  status          VehicleStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  orders Order[]
  logs   VehicleLog[]
}

model Telemetry {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  lat        Float
  lng        Float
  speed      Float?
  isSpeeding Boolean  @default(false)
  timestamp  DateTime @default(now())

  @@index([employeeId])
  @@index([timestamp(sort: Desc)])
}

model VehicleLog {
  id        String         @id @default(cuid())
  vehicleId String
  vehicle   Vehicle        @relation(fields: [vehicleId], references: [id])
  type      VehicleLogType
  cost      Float
  date      DateTime       @default(now())
  notes     String?

  @@index([vehicleId])
}

model RouteOrder {
  id                   String           @id @default(cuid())
  type                 RouteOrderType
  status               RouteOrderStatus @default(PENDIENTE)
  contactName          String
  contactPhone         String?
  contactEmail         String?
  address              String
  addressLat           Float?
  addressLng           Float?
  scheduledAt          DateTime
  notes                String?
  employeeId           String?
  employee             Employee?        @relation(fields: [employeeId], references: [id])
  originLocation       String?
  destLocation         String?
  carrier              String?
  sucursalNombre       String?
  signatureOrigin      String?
  signatureDestination String?
  photoDropoff         String[]
  completedAt          DateTime?
  deliveryLat          Float?
  deliveryLng          Float?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  items     RouteOrderItem[]
  issueLogs IssueLog[]

  @@index([employeeId])
  @@index([status])
  @@index([scheduledAt])
}

model RouteOrderItem {
  id            String     @id @default(cuid())
  routeOrderId  String
  routeOrder    RouteOrder @relation(fields: [routeOrderId], references: [id], onDelete: Cascade)
  tag           String
  description   String?
  qtyDispatched Int
  qtyDelivered  Int?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([routeOrderId])
}

model IssueLog {
  id           String     @id @default(cuid())
  routeOrderId String
  routeOrder   RouteOrder @relation(fields: [routeOrderId], references: [id])
  note         String
  hasDelta     Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([routeOrderId])
}

// ==========================================================
// 8. WHATSAPP CHAT (META API READY)
// ==========================================================
model WaConversation {
  id           String    @id @default(cuid())
  employeeId   String?
  employee     Employee? @relation(fields: [employeeId], references: [id])
  userId       String?
  user         User?     @relation(fields: [userId], references: [id])
  contactName  String?
  contactPhone String    @unique
  isOpen       Boolean   @default(true)

  handledBy           ChatHandler @default(BOT)
  lastAdminMessageAt  DateTime?
  aiResumePausedUntil DateTime?

  lastMessage   String?
  lastMessageAt DateTime?
  unreadCount   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  messages WaMessage[]

  // Índices de rendimiento para CRM fluido
  @@index([employeeId])
  @@index([handledBy])
  @@index([updatedAt(sort: Desc)])
}

model WaMessage {
  id             String         @id @default(cuid())
  waId           String?        @unique
  conversationId String
  conversation   WaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           WaMessageRole
  body           String
  mediaUrl       String?
  mediaType      String?
  isRead         Boolean        @default(false)
  sentAt         DateTime       @default(now())

  // Índices vitales para cargar rápido el historial de los chats
  @@index([conversationId])
  @@index([sentAt(sort: Desc)])
}

// ==========================================================
// 9. OUTBOUND & MARKETING (CONTACTOS MANUALES)
// ==========================================================

// ==========================================================
// FASE 12 — MODELOS NUEVOS (BOT V2)
// ==========================================================
model TelaNoManejada {
  id            String  @id @default(cuid())
  // Datos del cliente que la pidió
  clientePhone  String
  clienteNombre String?
  clienteUserId String?

  // La tela
  telaIdentificada String // ej. "popelina", "lino", "casimir"
  descripcionExtra String? // descripción adicional del bot/vision
  imagenUrl        String? // si vino con foto
  cantidadKg       Float? // cuánto necesita
  frecuencia       String? // "mensual", "única", "estacional"
  usoFinal         String? // "uniformes", "camisas", etc.

  status        TelaSolicitadaStatus @default(NUEVA)
  notasInternas String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([telaIdentificada])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model ProgramacionVolumen {
  id            String  @id @default(cuid())
  // Datos del cliente
  clientePhone  String
  clienteNombre String?
  clienteUserId String?

  // Programación
  telaSku       String? // SKU si está en catálogo
  telaTitulo    String // nombre legible
  kgPorPeriodo  Float // cuántos kg cada periodo
  periodo       String // "mensual" | "quincenal" | "semanal" | "unico"
  fechaInicio   DateTime
  duracionMeses Int      @default(1)

  estado String @default("propuesta")
  // estados: propuesta | confirmada | en_curso | completada | cancelada

  notas String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientePhone])
  @@index([estado])
  @@index([fechaInicio])
}

model ContactoOutbound {
  id          String  @id @default(cuid())
  phone       String  @unique
  nombre      String?
  empresa     String?
  notas       String?
  agregadoPor String?

  plantillaEnviada   Boolean   @default(false)
  plantillaEnviadaAt DateTime?
  plantillaResponse  String?

  clienteRespondio   Boolean   @default(false)
  primeraRespuestaAt DateTime?

  // Sales Agent Intelligence (Fase 1)
  coldReason           String?
  engagementScore      Int      @default(0)
  reactivationPriority Int      @default(0)
  status               String   @default("PENDING")
  tags                 String[] @default([])

  assignedToEmployeeId String?
  assignedToEmployee   Employee? @relation("AssignedColdContacts", fields: [assignedToEmployeeId], references: [id])
  assignedAt           DateTime?

  lastAttemptAt  DateTime?
  totalAttempts  Int       @default(0)
  nextFollowUpAt DateTime?

  attempts  SalesAgentAttempt[]
  feedbacks SalesAgentFeedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([plantillaEnviada])
  @@index([status])
  @@index([reactivationPriority(sort: Desc)])
  @@index([assignedToEmployeeId])
  @@index([nextFollowUpAt])
}

model BotEscalation {
  id          String    @id @default(cuid())
  phone       String
  nombre      String?
  razon       String // queja | humano | alto_valor | retries | frustracion | facturacion
  contexto    String    @db.Text
  ultimoMsg   String    @db.Text
  estado      String    @default("pendiente") // pendiente | atendida | descartada
  atendidaPor String?
  atendidaAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([phone])
  @@index([estado])
  @@index([createdAt])
  @@index([razon])
}

// ==========================================================
// SALES AGENT - Fase 1 (reactivacion contactos frios)
// ==========================================================
model SalesAgentAttempt {
  id        String           @id @default(cuid())
  contactId String
  contact   ContactoOutbound @relation(fields: [contactId], references: [id], onDelete: Cascade)

  channel      String
  messageSent  String  @db.Text
  strategy     String?
  agentVersion String?

  sentAt           DateTime  @default(now())
  sentByEmployeeId String?
  sentByEmployee   Employee? @relation("SalesAgentSentBy", fields: [sentByEmployeeId], references: [id])

  outcome      String?
  respondedAt  DateTime?
  responseText String?   @db.Text

  @@index([contactId])
  @@index([sentAt(sort: Desc)])
  @@index([outcome])
}

model SalesAgentFeedback {
  id         String           @id @default(cuid())
  contactId  String
  contact    ContactoOutbound @relation(fields: [contactId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee         @relation("SalesAgentFeedbacks", fields: [employeeId], references: [id])

  feedback String  @db.Text
  category String?

  createdAt DateTime @default(now())

  @@index([contactId])
  @@index([employeeId])
}

// ==========================================================
// PGVECTOR — Embeddings catalogo bot V2 (managed fuera de Prisma)
// ==========================================================
// La tabla la maneja MIGRATION.sql porque pgvector usa vector(1536)
// que Prisma no soporta. La declaramos con @@ignore para que
// Prisma sepa que existe y NO proponga reset por drift.
model bot_catalog_embeddings {
  product_id String   @id
  content    String
  metadata   Json?    @default("{}")
  updated_at DateTime @default(now()) @db.Timestamptz

  @@ignore
}
