generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================================
// ENUMS GLOBALES
// ==========================================================

enum EmployeeRole {
  ADMIN
  SUPERVISOR
  VENDEDORA
  LOGISTICA
  CONTABILIDAD
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  FAILED
}

enum LogisticsType {
  COYOTE_LOCAL
  SKYDROPX_NACIONAL
}

enum PickupLocation {
  GUATEMALA_97
  PLOMO_203
}

enum PipelineStatus {
  PROSPECTO
  COTIZANDO
  NEGOCIACION
  CERRADO_GANADO
  CERRADO_PERDIDO
}

enum InteractionType {
  LLAMADA
  WHATSAPP
  CORREO
  PRESENCIAL
}

enum TicketStatus {
  ABIERTO
  EN_REVISION
  RESUELTO
  CERRADO
}

enum TicketPriority {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum MembershipTier {
  NONE
  GOLD
  BLACK
  ELITE
}

enum VehicleStatus {
  ACTIVE
  IN_REPAIR
  RETIRED
}

enum VehicleLogType {
  GASOLINA
  SERVICIO
  REPARACION
}

enum RouteOrderType {
  RECOLECCION
  RESTOCK_INTERNO
  RESTOCK_PROVEEDOR
  ENTREGA_PAQUETERIA
  ENTREGA_DOMICILIO
}

enum RouteOrderStatus {
  PENDIENTE
  ASIGNADA
  EN_CAMINO
  COMPLETADA
  CANCELADA
}

enum UnitType {
  KILO
  METRO
  PIEZA
}

enum MovementType {
  ENTRADA
  SALIDA
  AJUSTE
}

// ==========================================================
// 1. USUARIO / CLIENTE (B2B & B2C)
// ==========================================================
model User {
  id                       String         @id @default(cuid())
  hashId                   String         @unique @default(dbgenerated("concat('CL-', substr(gen_random_uuid()::text, 1, 6))"))
  name                     String?
  email                    String         @unique
  password                 String
  image                    String?
  phone                    String?
  role                     String         @default("USER")
  membershipTier           MembershipTier @default(NONE)
  membershipExpiry         DateTime?

  // FIX #7: Int en vez de Float — evita errores de punto flotante en puntos de lealtad
  points                   Int            @default(0)

  stripeCustomerId         String?
  stripeSubscriptionId     String?
  stripeSubscriptionStatus String?

  ltv                      Float          @default(0)
  rfc                      String?
  taxRegime                String?
  cfdiUse                  String?
  street                   String?
  neighborhood             String?
  zipCode                  String?
  city                     String?
  state                    String?
  optedIn                  Boolean        @default(false)
  suppressed               Boolean        @default(false)
  consentDate              DateTime?
  optOutDate               DateTime?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  orders                   Order[]
  interactions             Interaction[]
  tickets                  Ticket[]
  deals                    Deal[]
}

// ==========================================================
// 2. LA JAURIA (EQUIPO INTERNO)
// ==========================================================
model Employee {
  id              String        @id @default(cuid())
  name            String
  email           String        @unique
  password        String
  role            EmployeeRole  @default(VENDEDORA)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  logs            AuditLog[]
  attendances     Attendance[]
  interactions    Interaction[]
  assignedTickets Ticket[]
  telemetry       Telemetry[]
  routeOrders     RouteOrder[]
  deals           Deal[]
}

model AuditLog {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  action     String
  resourceId String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
}

// ==========================================================
// 3. CATALOGO CENTRAL & INVENTARIO FISICO
// ==========================================================
model Product {
  id               String              @id @default(cuid())
  sku              String              @unique
  title            String
  unit             UnitType            @default(KILO)
  thumbnail        String?
  description      String?
  composicion      String?
  gramaje          String?
  ancho            String?
  rendimiento      Float?
  priceMenudeo     Float
  priceMayoreo     Float
  hasRollo         Boolean             @default(true)
  unidadesPorRollo Float?
  singleColor      Boolean             @default(true)
  origin           String?
  category         String
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  colors           ProductColor[]
  inventory        Inventory[]
  orderItems       OrderItem[]
  deals            Deal[]
  movements        InventoryMovement[]
}

model ProductColor {
  id        String              @id @default(cuid())
  productId String
  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  hex       String
  imageUrl  String?

  inventory Inventory[]
  movements InventoryMovement[]
}

model Inventory {
  id        String         @id @default(cuid())
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  // FIX #2: El @@unique con colorId nullable no es suficiente en PostgreSQL —
  // dos NULLs no son iguales en un indice UNIQUE, lo que permite duplicados silenciosos
  // para productos sin color en la misma sucursal.
  // ACCION REQUERIDA: Despues de migrar, corre este SQL manualmente en Supabase:
  //
  //   CREATE UNIQUE INDEX inventory_no_color_unique
  //   ON "Inventory"("productId", "location")
  //   WHERE "colorId" IS NULL;
  //
  colorId   String?
  color     ProductColor?  @relation(fields: [colorId], references: [id])

  location  PickupLocation
  quantity  Float
  rollCount Int            @default(0)
  updatedAt DateTime       @updatedAt

  @@unique([productId, colorId, location])
}

// KARDEX — cerebro del control de inventario
model InventoryMovement {
  id           String         @id @default(cuid())
  productId    String
  product      Product        @relation(fields: [productId], references: [id])
  colorId      String?
  color        ProductColor?  @relation(fields: [colorId], references: [id])

  location     PickupLocation
  type         MovementType

  quantity     Float
  // FIX #3: @default(0) — evita crash si el form no envia rollCount
  rollCount    Int            @default(0)

  provider     String?
  authorizedBy String
  notes        String?

  // FIX #6: Trazabilidad — vincula movimiento a la orden que lo origino
  orderId      String?
  order        Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt    DateTime       @default(now())
}

// ==========================================================
// 4. CRM: PIPELINE & VENTAS MAYORISTAS
// ==========================================================
model Deal {
  id         String         @id @default(cuid())
  title      String
  company    String

  userId     String?
  user       User?          @relation(fields: [userId], references: [id])

  employeeId String
  employee   Employee       @relation(fields: [employeeId], references: [id])

  // FIX #4: productId ahora es opcional — en PROSPECTO puede no saberse el producto aun
  productId  String?
  product    Product?       @relation(fields: [productId], references: [id])

  color      String?
  quantity   Float?
  value      Float          @default(0)
  status     PipelineStatus @default(PROSPECTO)

  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

// ==========================================================
// 5. E-COMMERCE & LOGISTICA DE COMPRA
// ==========================================================
model Order {
  id             String         @id @default(cuid())
  orderNumber    String         @unique @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  subtotal       Float          @default(0)
  freightCost    Float          @default(0)
  shippingCost   Float          @default(0)
  serviceFee     Float          @default(0)
  taxIVA         Float          @default(0)
  total          Float
  status         OrderStatus    @default(PENDING)
  evidenceUrl    String?
  deliveryLat    Float?
  deliveryLng    Float?
  paymentMethod  String         @default("card")
  paymentId      String?
  logisticsType  LogisticsType  @default(SKYDROPX_NACIONAL)
  pickupLocation PickupLocation @default(GUATEMALA_97)
  vehiclesNeeded Int            @default(1)
  trackingNumber String?
  trackingUrl    String?
  customerName   String
  customerEmail  String
  customerPhone  String?
  address        String?
  wantsInvoice   Boolean        @default(false)
  invoiceStatus  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  items          OrderItem[]
  tickets        Ticket[]
  // FIX #6: relacion inversa con el Kardex
  movements      InventoryMovement[]

  // FIX #5: onDelete SetNull — borrar un Vehicle no rompe ordenes historicas
  vehicleId      String?
  vehicle        Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  title     String
  sku       String?
  price     Float
  quantity  Float
  unit      String?
  color     String?
}

// ==========================================================
// 6. ERP & OPERACION INTERNA
// ==========================================================
model Attendance {
  id              String    @id @default(cuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id])
  checkIn         DateTime  @default(now())
  checkOut        DateTime?
  horasTrabajadas Float?
  ipAddress       String?
  location        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Interaction {
  id             String          @id @default(cuid())
  employeeId     String
  employee       Employee        @relation(fields: [employeeId], references: [id])
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  type           InteractionType
  summary        String
  pipelineStatus PipelineStatus?
  date           DateTime        @default(now())
  nextFollowUp   DateTime?
}

model ShippingZone {
  id            String   @id @default(cuid())
  name          String
  zipCodes      String[]
  baseRate      Float    @default(0)
  estimatedDays Int      @default(1)
  isActive      Boolean  @default(true)
}

model Ticket {
  id           String         @id @default(cuid())
  ticketNumber String         @unique @default(dbgenerated("concat('TK-', substr(gen_random_uuid()::text, 1, 6))"))
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  employeeId   String?
  employee     Employee?      @relation(fields: [employeeId], references: [id])
  orderId      String?
  order        Order?         @relation(fields: [orderId], references: [id])
  subject      String
  description  String
  status       TicketStatus   @default(ABIERTO)
  priority     TicketPriority @default(MEDIA)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// ==========================================================
// 7. FLOTILLA AVANZADA Y RUTAS
// ==========================================================
model Vehicle {
  id              String        @id @default(cuid())
  plate           String        @unique
  model           String
  lastMaintenance DateTime      @default(now())
  nextMaintenance DateTime
  mileage         Float         @default(0)
  status          VehicleStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  orders          Order[]
  logs            VehicleLog[]
}

model Telemetry {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  lat        Float
  lng        Float
  speed      Float?
  isSpeeding Boolean  @default(false)
  timestamp  DateTime @default(now())
}

model VehicleLog {
  id        String         @id @default(cuid())
  vehicleId String
  vehicle   Vehicle        @relation(fields: [vehicleId], references: [id])
  type      VehicleLogType
  cost      Float
  date      DateTime       @default(now())
  notes     String?
}

model RouteOrder {
  id                   String           @id @default(cuid())
  type                 RouteOrderType
  status               RouteOrderStatus @default(PENDIENTE)

  contactName          String
  contactPhone         String?
  contactEmail         String?

  address              String
  addressLat           Float?
  addressLng           Float?

  scheduledAt          DateTime
  notes                String?

  // FIX: renombrado de `assignedTo` a `employeeId` — consistente con todo el schema
  employeeId           String?
  employee             Employee?        @relation(fields: [employeeId], references: [id])

  originLocation       String?
  destLocation         String?

  carrier              String?
  sucursalNombre       String?

  signatureOrigin      String?
  signatureDestination String?
  photoDropoff         String[]
  completedAt          DateTime?
  deliveryLat          Float?
  deliveryLng          Float?

  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  items                RouteOrderItem[]
  issueLogs            IssueLog[]
}

model RouteOrderItem {
  id            String     @id @default(cuid())
  routeOrderId  String
  routeOrder    RouteOrder @relation(fields: [routeOrderId], references: [id], onDelete: Cascade)
  tag           String
  description   String?
  qtyDispatched Int
  qtyDelivered  Int?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model IssueLog {
  id           String     @id @default(cuid())
  routeOrderId String
  routeOrder   RouteOrder @relation(fields: [routeOrderId], references: [id])
  note         String
  hasDelta     Boolean    @default(false)
  createdAt    DateTime   @default(now())
}