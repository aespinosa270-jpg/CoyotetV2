generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================================
// ENUMS
// ==========================================================

enum EmployeeRole {
  ADMIN
  SUPERVISOR
  VENDEDORA
  LOGISTICA
  CONTABILIDAD
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  FAILED
}

enum LogisticsType {
  COYOTE_LOCAL
  SKYDROPX_NACIONAL
}

enum PickupLocation {
  GUATEMALA_97
  PLOMO_203
}

enum PipelineStatus {
  PROSPECTO
  COTIZANDO
  NEGOCIACION
  CERRADO_GANADO
  CERRADO_PERDIDO
}

enum InteractionType {
  LLAMADA
  WHATSAPP
  CORREO
  PRESENCIAL
}

enum TicketStatus {
  ABIERTO
  EN_REVISION
  RESUELTO
  CERRADO
}

enum TicketPriority {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum MembershipTier {
  NONE
  GOLD
  BLACK
  ELITE
}

enum VehicleStatus {
  ACTIVE
  IN_REPAIR
  RETIRED
}

enum VehicleLogType {
  GASOLINA
  SERVICIO
  REPARACION
}

enum RouteOrderType {
  RECOLECCION          // Recolección en domicilio de cliente
  RESTOCK_INTERNO      // Transferencia Plomo 203 ↔ Guatemala 97
  RESTOCK_PROVEEDOR    // Recolección en ubicación de proveedor externo
  ENTREGA_PAQUETERIA   // Drop-off en sucursal de paquetería
  ENTREGA_DOMICILIO    // Entrega directa al cliente
}

enum RouteOrderStatus {
  PENDIENTE
  ASIGNADA
  EN_CAMINO
  COMPLETADA
  CANCELADA
}

// ==========================================================
// 1. USUARIO / CLIENTE
// ==========================================================
model User {
  id                     String         @id @default(cuid())
  hashId                 String         @unique @default(dbgenerated("concat('CL-', substr(gen_random_uuid()::text, 1, 6))"))
  name                   String?
  email                  String         @unique
  password               String
  image                  String?
  phone                  String?
  role                   String         @default("USER")
  membershipTier         MembershipTier @default(NONE)
  membershipExpiry       DateTime?
  points                 Float          @default(0)
  
  // 🐺 BÓVEDA STRIPE (Reemplazo de OpenPay)
  stripeCustomerId         String?
  stripeSubscriptionId     String?
  stripeSubscriptionStatus String?      // 🔥 LÍNEA AÑADIDA PARA EL WEBHOOK
  
  ltv                    Float          @default(0)
  rfc                    String?
  taxRegime              String?
  cfdiUse                String?
  street                 String?
  neighborhood           String?
  zipCode                String?
  city                   String?
  state                  String?
  optedIn                Boolean        @default(false)
  suppressed             Boolean        @default(false)
  consentDate            DateTime?
  optOutDate             DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  orders                 Order[]
  interactions           Interaction[]
  tickets                Ticket[]
}

// ==========================================================
// 2. EQUIPO INTERNO
// ==========================================================
model Employee {
  id              String        @id @default(cuid())
  name            String
  email           String        @unique
  password        String        // Unificado para acceso administrativo y móvil
  role            EmployeeRole  @default(VENDEDORA)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  logs            AuditLog[]
  attendances     Attendance[]
  interactions    Interaction[]
  assignedTickets Ticket[]
  telemetry       Telemetry[]    // Historial GPS
  routeOrders     RouteOrder[]   // Órdenes de ruta asignadas
}

model AuditLog {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  action     String
  resourceId String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
}

// ==========================================================
// 3. E-COMMERCE & LOGÍSTICA
// ==========================================================
model Order {
  id             String         @id @default(cuid())
  orderNumber    String         @unique @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  subtotal       Float          @default(0)
  freightCost    Float          @default(0)
  shippingCost   Float          @default(0)
  serviceFee     Float          @default(0)
  taxIVA         Float          @default(0)
  total          Float
  status         OrderStatus    @default(PENDING)
  evidenceUrl    String?
  deliveryLat    Float?
  deliveryLng    Float?
  paymentMethod  String         @default("card")
  paymentId      String?
  logisticsType  LogisticsType  @default(SKYDROPX_NACIONAL)
  pickupLocation PickupLocation @default(GUATEMALA_97)
  vehiclesNeeded Int            @default(1)
  trackingNumber String?
  trackingUrl    String?
  customerName   String
  customerEmail  String
  customerPhone  String?
  address        String?
  wantsInvoice   Boolean        @default(false)
  invoiceStatus  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  items          OrderItem[]
  tickets        Ticket[]

  vehicleId      String?
  vehicle        Vehicle?       @relation(fields: [vehicleId], references: [id])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  title     String
  sku       String?
  price     Float
  quantity  Float
  unit      String?
  color     String?
}

// ==========================================================
// 4. ERP: MÓDULOS EXISTENTES
// ==========================================================

model Attendance {
  id              String    @id @default(cuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id])
  checkIn         DateTime  @default(now())
  checkOut        DateTime?
  horasTrabajadas Float?
  ipAddress       String?
  location        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Interaction {
  id             String          @id @default(cuid())
  employeeId     String
  employee       Employee        @relation(fields: [employeeId], references: [id])
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  type           InteractionType
  summary        String
  pipelineStatus PipelineStatus?
  date           DateTime        @default(now())
  nextFollowUp   DateTime?
}

model ShippingZone {
  id            String   @id @default(cuid())
  name          String
  zipCodes      String[]
  baseRate      Float    @default(0)
  estimatedDays Int      @default(1)
  isActive      Boolean  @default(true)
}

model Ticket {
  id           String         @id @default(cuid())
  ticketNumber String         @unique @default(dbgenerated("concat('TK-', substr(gen_random_uuid()::text, 1, 6))"))
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  employeeId   String?
  employee     Employee?      @relation(fields: [employeeId], references: [id])
  orderId      String?
  order        Order?         @relation(fields: [orderId], references: [id])
  subject      String
  description  String
  status       TicketStatus   @default(ABIERTO)
  priority     TicketPriority @default(MEDIA)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// ==========================================================
// 5. MÓDULOS DE FLOTILLA AVANZADA Y RUTAS
// ==========================================================

model Vehicle {
  id              String        @id @default(cuid())
  plate           String        @unique
  model           String
  lastMaintenance DateTime      @default(now())
  nextMaintenance DateTime
  mileage         Float         @default(0)
  status          VehicleStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  orders          Order[]
  logs            VehicleLog[]
}

model Telemetry {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  lat        Float
  lng        Float
  speed      Float?
  isSpeeding Boolean  @default(false)
  timestamp  DateTime @default(now())
}

model VehicleLog {
  id        String         @id @default(cuid())
  vehicleId String
  vehicle   Vehicle        @relation(fields: [vehicleId], references: [id])
  type      VehicleLogType
  cost      Float
  date      DateTime       @default(now())
  notes     String?
}

model RouteOrder {
  id                   String           @id @default(cuid())
  type                 RouteOrderType
  status               RouteOrderStatus @default(PENDIENTE)

  // Cliente / Contacto
  contactName          String
  contactPhone         String?
  contactEmail         String?

  // Dirección y Ubicación
  address              String
  addressLat           Float?
  addressLng           Float?

  // Planificación
  scheduledAt          DateTime
  notes                String?

  // Asignación
  assignedTo           String?          
  employee             Employee?        @relation(fields: [assignedTo], references: [id])

  // Restock Interno
  originLocation       String?          // PLOMO_203 | GUATEMALA_97
  destLocation         String?          
  
  // Paquetería
  carrier              String?          
  sucursalNombre       String?          

  // Evidencia y Cierre
  signatureOrigin      String?
  signatureDestination String?
  photoDropoff         String[]
  completedAt          DateTime?
  deliveryLat          Float?
  deliveryLng          Float?

  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  items                RouteOrderItem[]
  issueLogs            IssueLog[]
}

model RouteOrderItem {
  id            String     @id @default(cuid())
  routeOrderId  String
  routeOrder    RouteOrder @relation(fields: [routeOrderId], references: [id], onDelete: Cascade)
  tag           String     
  description   String?    
  qtyDispatched Int        
  qtyDelivered  Int?       
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model IssueLog {
  id           String     @id @default(cuid())
  routeOrderId String
  routeOrder   RouteOrder @relation(fields: [routeOrderId], references: [id])
  note         String
  hasDelta     Boolean    @default(false)
  createdAt    DateTime   @default(now())
}